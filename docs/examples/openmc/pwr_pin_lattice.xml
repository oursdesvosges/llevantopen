<?xml version='1.0' encoding='utf-8'?>
<model>
  <!-- 3x3 PWR Fuel Pin Lattice with Central B4C Control Guide Tube -->
  <materials>
    <material id="1" name="UO2 Fuel (4.2% Enriched)">
      <density units="g/cm3" value="10.4"/>
      <nuclide name="U235" ao="0.014"/>
      <nuclide name="U238" ao="0.3193"/>
      <nuclide name="O16"  ao="0.6667"/>
    </material>
    <material id="2" name="Helium Gap">
      <density units="g/cm3" value="0.0015"/>
      <nuclide name="He4" ao="1.0"/>
    </material>
    <material id="3" name="Zircaloy-4 Cladding">
      <density units="g/cm3" value="6.56"/>
      <nuclide name="Zr90" wo="0.982"/>
      <nuclide name="Sn120" wo="0.015"/>
      <nuclide name="Fe56" wo="0.002"/>
      <nuclide name="Cr52" wo="0.001"/>
    </material>
    <material id="4" name="Borated Light Water Moderator">
      <density units="g/cm3" value="0.72"/>
      <nuclide name="H1"  ao="0.6660"/>
      <nuclide name="O16" ao="0.3330"/>
      <nuclide name="B10" ao="0.0010"/>
    </material>
    <material id="5" name="B4C Control Rod Absorber">
      <density units="g/cm3" value="2.52"/>
      <nuclide name="B10" ao="0.16"/>
      <nuclide name="B11" ao="0.64"/>
      <nuclide name="C0"  ao="0.20"/>
    </material>
    <material id="6" name="SS304 Assembly Shroud">
      <density units="g/cm3" value="7.92"/>
      <nuclide name="Fe56" wo="0.70"/>
      <nuclide name="Cr52" wo="0.19"/>
      <nuclide name="Ni58" wo="0.10"/>
      <nuclide name="Mn55" wo="0.01"/>
    </material>
  </materials>

  <geometry>
    <!-- Pin surfaces (local universe coords) -->
    <surface id="1" type="z-cylinder" coeffs="0 0 0.4096" name="Fuel pellet radius"/>
    <surface id="2" type="z-cylinder" coeffs="0 0 0.4180" name="Gap outer radius"/>
    <surface id="3" type="z-cylinder" coeffs="0 0 0.4750" name="Cladding outer radius"/>
    <surface id="4" type="z-cylinder" coeffs="0 0 0.4300" name="Control rod B4C radius"/>
    <surface id="5" type="z-cylinder" coeffs="0 0 0.5000" name="Guide tube outer radius"/>

    <!-- Outer assembly box + shroud -->
    <surface id="10" type="x-plane" coeffs="-1.89"/>
    <surface id="11" type="x-plane" coeffs="1.89"/>
    <surface id="12" type="y-plane" coeffs="-1.89"/>
    <surface id="13" type="y-plane" coeffs="1.89"/>

    <surface id="20" type="x-plane" coeffs="-2.20" boundary="vacuum"/>
    <surface id="21" type="x-plane" coeffs="2.20"  boundary="vacuum"/>
    <surface id="22" type="y-plane" coeffs="-2.20" boundary="vacuum"/>
    <surface id="23" type="y-plane" coeffs="2.20"  boundary="vacuum"/>
    <surface id="24" type="z-plane" coeffs="-5.00" boundary="vacuum"/>
    <surface id="25" type="z-plane" coeffs="5.00"  boundary="vacuum"/>

    <!-- Universe 2: Fuel Pin -->
    <cell id="1" universe="2" material="1" region="-1"     name="UO2 Fuel Pellet"/>
    <cell id="2" universe="2" material="2" region="1 -2"   name="Helium Gap"/>
    <cell id="3" universe="2" material="3" region="2 -3"   name="Zircaloy Cladding"/>
    <cell id="4" universe="2" material="4" region="3"      name="Pin Water Moderator"/>

    <!-- Universe 3: Control Rod / Guide Tube -->
    <cell id="5" universe="3" material="5" region="-4"     name="B4C Control Rod"/>
    <cell id="6" universe="3" material="3" region="4 -5"   name="Zircaloy Guide Tube"/>
    <cell id="7" universe="3" material="4" region="5"      name="Guide Tube Water"/>

    <!-- 3x3 Lattice (pitch = 1.26 cm, lower_left = -1.89, -1.89) -->
    <lattice id="100" name="3x3 PWR Mini-Assembly">
      <dimension>3 3</dimension>
      <lower_left>-1.89 -1.89</lower_left>
      <pitch>1.26 1.26</pitch>
      <universes>
        2 2 2
        2 3 2
        2 2 2
      </universes>
    </lattice>

    <!-- Root Universe 1 -->
    <cell id="10" universe="1" fill="100" region="10 -11 12 -13 24 -25" name="3x3 Pin Lattice Region"/>
    <cell id="11" universe="1" material="6" region="20 -21 22 -23 24 -25 ~(10 -11 12 -13)" name="SS304 Assembly Shroud"/>
  </geometry>
</model>
