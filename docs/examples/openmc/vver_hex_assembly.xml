<?xml version='1.0' encoding='utf-8'?>
<model>
  <!-- 3-Ring VVER-style Hexagonal Fuel Assembly inside Cylindrical Steel Wrapper & Reflector -->
  <materials>
    <material id="1" name="UO2 4.4% Enriched Fuel">
      <density units="g/cm3" value="10.4"/>
      <nuclide name="U235" ao="0.0147"/>
      <nuclide name="U238" ao="0.3186"/>
      <nuclide name="O16"  ao="0.6667"/>
    </material>
    <material id="2" name="Zircaloy-4 Cladding">
      <density units="g/cm3" value="6.56"/>
      <nuclide name="Zr90" wo="0.982"/>
      <nuclide name="Sn120" wo="0.015"/>
      <nuclide name="Fe56" wo="0.002"/>
      <nuclide name="Cr52" wo="0.001"/>
    </material>
    <material id="3" name="Borated Light Water Coolant">
      <density units="g/cm3" value="0.72"/>
      <nuclide name="H1"  ao="0.6660"/>
      <nuclide name="O16" ao="0.3330"/>
      <nuclide name="B10" ao="0.0010"/>
    </material>
    <material id="4" name="Gd2O3-UO2 Burnable Poison">
      <density units="g/cm3" value="10.1"/>
      <nuclide name="U235"  ao="0.010"/>
      <nuclide name="U238"  ao="0.290"/>
      <nuclide name="Gd155" ao="0.015"/>
      <nuclide name="Gd157" ao="0.018"/>
      <nuclide name="O16"   ao="0.667"/>
    </material>
    <material id="5" name="SS316 Hex Wrapper Duct">
      <density units="g/cm3" value="7.95"/>
      <nuclide name="Fe56" wo="0.67"/>
      <nuclide name="Cr52" wo="0.17"/>
      <nuclide name="Ni58" wo="0.12"/>
      <nuclide name="Mo98" wo="0.025"/>
      <nuclide name="Mn55" wo="0.015"/>
    </material>
    <material id="6" name="B4C Control Guide Tube">
      <density units="g/cm3" value="2.52"/>
      <nuclide name="B10" ao="0.16"/>
      <nuclide name="B11" ao="0.64"/>
      <nuclide name="C0"  ao="0.20"/>
    </material>
  </materials>

  <geometry>
    <!-- Local pin surfaces -->
    <surface id="1" type="z-cylinder" coeffs="0 0 0.390" name="Fuel or poison pellet outer"/>
    <surface id="2" type="z-cylinder" coeffs="0 0 0.455" name="Pin clad outer"/>
    <surface id="3" type="z-cylinder" coeffs="0 0 0.410" name="B4C absorber outer"/>
    <surface id="4" type="z-cylinder" coeffs="0 0 0.470" name="Control clad outer"/>

    <!-- Assembly duct and surrounding reflector -->
    <surface id="10" type="z-cylinder" coeffs="0 0 3.55" name="Wrapper inner radius"/>
    <surface id="11" type="z-cylinder" coeffs="0 0 3.85" name="Wrapper outer radius"/>
    <surface id="12" type="z-cylinder" coeffs="0 0 4.60" boundary="vacuum" name="Reflector outer"/>
    <surface id="13" type="z-plane" coeffs="-15.0" boundary="vacuum" name="Bottom boundary"/>
    <surface id="14" type="z-plane" coeffs="15.0"  boundary="vacuum" name="Top boundary"/>

    <!-- Universe 1: Standard UO2 Fuel Pin -->
    <cell id="1" universe="1" material="1" region="-1"   name="UO2 Fuel Pellet"/>
    <cell id="2" universe="1" material="2" region="1 -2" name="Fuel Zircaloy Clad"/>
    <cell id="3" universe="1" material="3" region="2"    name="Pin Channel Coolant"/>

    <!-- Universe 2: Gd2O3-UO2 Burnable Poison Pin -->
    <cell id="4" universe="2" material="4" region="-1"   name="Gd2O3 Burnable Poison Pellet"/>
    <cell id="5" universe="2" material="2" region="1 -2" name="Gd Pin Zircaloy Clad"/>
    <cell id="6" universe="2" material="3" region="2"    name="Gd Channel Coolant"/>

    <!-- Universe 3: Central B4C Control / Instrumentation Rod -->
    <cell id="7" universe="3" material="6" region="-3"   name="B4C Control Absorber"/>
    <cell id="8" universe="3" material="2" region="3 -4" name="Control Guide Clad"/>
    <cell id="9" universe="3" material="3" region="4"    name="Control Channel Coolant"/>

    <!-- Universe 4: Outer Coolant Matrix -->
    <cell id="10" universe="4" material="3" name="Outer Assembly Coolant"/>

    <!-- 3-Ring Hexagonal Lattice (pitch = 1.275 cm, y-orientation) -->
    <hex_lattice id="200" n_rings="3" orientation="y" name="VVER Hex Fuel Lattice">
      <pitch>1.275</pitch>
      <outer>4</outer>
      <center>0.0 0.0</center>
      <universes>
          1
        1   1
      1   2   1
        1   1
      1   3   1
        1   1
      1   2   1
        1   1
          1
      </universes>
    </hex_lattice>

    <!-- Root Universe 0 -->
    <cell id="20" universe="0" fill="200" region="-10 13 -14"   name="Hex Lattice Active Core"/>
    <cell id="21" universe="0" material="5" region="10 -11 13 -14" name="SS316 Hex Wrapper Duct"/>
    <cell id="22" universe="0" material="3" region="11 -12 13 -14" name="Water Reflector"/>
  </geometry>
</model>
