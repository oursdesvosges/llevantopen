<?xml version='1.0' encoding='utf-8'?>
<model>
  <!-- Realistic Fusion Liquid-Metal Blanket + HTS Magnet + NBI Diagnostic Port Cutout -->
  <materials>
    <material id="1" name="Tungsten First Wall Armor">
      <density units="g/cm3" value="19.25"/>
      <nuclide name="W182" ao="0.2650"/>
      <nuclide name="W183" ao="0.1431"/>
      <nuclide name="W184" ao="0.3064"/>
      <nuclide name="W186" ao="0.2843"/>
    </material>
    <material id="2" name="Eurofer97 RAFM Steel">
      <density units="g/cm3" value="7.85"/>
      <nuclide name="Fe56" wo="0.888"/>
      <nuclide name="Cr52" wo="0.090"/>
      <nuclide name="W184" wo="0.011"/>
      <nuclide name="Mn55" wo="0.004"/>
      <nuclide name="V51"  wo="0.002"/>
      <nuclide name="Ta181" wo="0.0012"/>
      <nuclide name="C0"   wo="0.0011"/>
      <nuclide name="Si28" wo="0.0027"/>
    </material>
    <material id="3" name="Pb-17Li Liquid Metal Breeder (90% Li-6)">
      <density units="g/cm3" value="9.36"/>
      <nuclide name="Pb206" ao="0.200"/>
      <nuclide name="Pb207" ao="0.183"/>
      <nuclide name="Pb208" ao="0.447"/>
      <nuclide name="Li6"   ao="0.153"/>
      <nuclide name="Li7"   ao="0.017"/>
    </material>
    <material id="4" name="Homogenised SS316LN + H2O + B4C Shield">
      <density units="g/cm3" value="5.45"/>
      <nuclide name="Fe56" wo="0.440"/>
      <nuclide name="Cr52" wo="0.110"/>
      <nuclide name="Ni58" wo="0.075"/>
      <nuclide name="H1"   wo="0.032"/>
      <nuclide name="O16"  wo="0.253"/>
      <nuclide name="B10"  wo="0.018"/>
      <nuclide name="B11"  wo="0.052"/>
      <nuclide name="C0"   wo="0.020"/>
    </material>
    <material id="5" name="HTS REBCO + Copper + Hastelloy Winding Pack">
      <density units="g/cm3" value="8.15"/>
      <nuclide name="Cu63" wo="0.450"/>
      <nuclide name="Cu65" wo="0.200"/>
      <nuclide name="Ni58" wo="0.160"/>
      <nuclide name="Cr52" wo="0.060"/>
      <nuclide name="Mo98" wo="0.050"/>
      <nuclide name="Y89"  wo="0.015"/>
      <nuclide name="Ba138" wo="0.035"/>
      <nuclide name="O16"  wo="0.030"/>
    </material>
    <material id="6" name="Heavy Barytes Concrete Bioshield">
      <density units="g/cm3" value="3.50"/>
      <nuclide name="O16"  wo="0.330"/>
      <nuclide name="Ba138" wo="0.410"/>
      <nuclide name="Ca40" wo="0.085"/>
      <nuclide name="Si28" wo="0.070"/>
      <nuclide name="S32"  wo="0.090"/>
      <nuclide name="H1"   wo="0.015"/>
    </material>
    <material id="7" name="Fused Silica Diagnostic Window">
      <density units="g/cm3" value="2.20"/>
      <nuclide name="Si28" ao="0.3333"/>
      <nuclide name="O16"  ao="0.6667"/>
    </material>
    <material id="8" name="Pressurized Water Coolant">
      <density units="g/cm3" value="0.72"/>
      <nuclide name="H1"  ao="0.6667"/>
      <nuclide name="O16" ao="0.3333"/>
    </material>
  </materials>

  <geometry>
    <!-- Coaxial cylindrical fusion sector radial build (axis along Z, R = 0..220 cm) -->
    <surface id="1"  type="z-cylinder" coeffs="0 0 60.0"  name="Plasma outer radius"/>
    <surface id="2"  type="z-cylinder" coeffs="0 0 64.0"  name="Tungsten FW outer"/>
    <surface id="3"  type="z-cylinder" coeffs="0 0 70.0"  name="Eurofer FW structure outer"/>
    <surface id="4"  type="z-cylinder" coeffs="0 0 118.0" name="PbLi breeder outer"/>
    <surface id="5"  type="z-cylinder" coeffs="0 0 126.0" name="Eurofer backplate outer"/>
    <surface id="6"  type="z-cylinder" coeffs="0 0 154.0" name="Homogenised shield outer"/>
    <surface id="7"  type="z-cylinder" coeffs="0 0 166.0" name="Cryostat gap outer"/>
    <surface id="8"  type="z-cylinder" coeffs="0 0 186.0" name="HTS magnet coil outer"/>
    <surface id="9"  type="z-cylinder" coeffs="0 0 218.0" boundary="vacuum" name="Concrete bioshield outer"/>

    <!-- Axial bounds Z in [-120, 120] cm -->
    <surface id="10" type="z-plane" coeffs="-120.0" boundary="vacuum" name="Bottom boundary"/>
    <surface id="11" type="z-plane" coeffs="120.0"  boundary="vacuum" name="Top boundary"/>

    <!-- Internal coolant pipes inside the PbLi breeder zone (3 vertical water cooling tubes) -->
    <surface id="20" type="z-cylinder" coeffs="94.0 0.0 5.5"   name="Coolant tube 0deg"/>
    <surface id="21" type="z-cylinder" coeffs="-47.0 81.4 5.5" name="Coolant tube 120deg"/>
    <surface id="22" type="z-cylinder" coeffs="-47.0 -81.4 5.5" name="Coolant tube 240deg"/>

    <!-- Radial NBI / Diagnostic Port along +X axis (x > 0) -->
    <surface id="30" type="x-cylinder" coeffs="0.0 0.0 18.0" name="Port inner vacuum duct"/>
    <surface id="31" type="x-cylinder" coeffs="0.0 0.0 23.0" name="Port steel sleeve outer"/>
    <surface id="32" type="x-plane" coeffs="0.0"   name="Port half-space x > 0"/>
    <surface id="33" type="x-plane" coeffs="156.0" name="Diagnostic window inner"/>
    <surface id="34" type="x-plane" coeffs="163.0" name="Diagnostic window outer"/>

    <!-- Cells (Root Universe 1) -->
    <cell id="1"  universe="1" material="void" name="D-T Plasma Chamber"
          region="-1 10 -11"/>
    <cell id="2"  universe="1" material="1" name="Tungsten First Wall Armor"
          region="1 -2 10 -11 ~(-31 32)"/>
    <cell id="3"  universe="1" material="2" name="Eurofer97 First Wall Structure"
          region="2 -3 10 -11 ~(-31 32)"/>
    <cell id="4"  universe="1" material="3" name="Pb-17Li Liquid Metal Breeder"
          region="3 -4 10 -11 20 21 22 ~(-31 32)"/>
    <cell id="5"  universe="1" material="8" name="PWR Coolant Tube 1"
          region="-20 10 -11 ~(-31 32)"/>
    <cell id="6"  universe="1" material="8" name="PWR Coolant Tube 2"
          region="-21 10 -11"/>
    <cell id="7"  universe="1" material="8" name="PWR Coolant Tube 3"
          region="-22 10 -11"/>
    <cell id="8"  universe="1" material="2" name="Eurofer97 Back Manifold Plate"
          region="4 -5 10 -11 ~(-31 32)"/>
    <cell id="9"  universe="1" material="4" name="Homogenised SS316LN+H2O+B4C Shield"
          region="5 -6 10 -11 ~(-31 32)"/>
    <cell id="10" universe="1" material="void" name="Cryostat Thermal Vacuum Gap"
          region="6 -7 10 -11 ~(-31 32)"/>
    <cell id="11" universe="1" material="5" name="HTS REBCO Magnet Winding Pack"
          region="7 -8 10 -11 ~(-31 32)"/>
    <cell id="12" universe="1" material="6" name="Heavy Concrete Bioshield"
          region="8 -9 10 -11 ~(-31 32)"/>

    <!-- Diagnostic Port Assembly (Sleeve, Vacuum Duct, Quartz Window) -->
    <cell id="13" universe="1" material="2" name="Diagnostic Port Steel Sleeve"
          region="1 -9 30 -31 32"/>
    <cell id="14" universe="1" material="void" name="Diagnostic Port Inner Duct"
          region="1 -33 -30 32"/>
    <cell id="15" universe="1" material="7" name="Fused Silica Diagnostic Window"
          region="33 -34 -30 32"/>
    <cell id="16" universe="1" material="void" name="Diagnostic Port Outer Cavity"
          region="34 -9 -30 32"/>
  </geometry>
</model>
